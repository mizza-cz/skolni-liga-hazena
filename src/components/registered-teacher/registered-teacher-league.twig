<section class="registered-teacher">
  <form class="menuFilter">
    <div class="menuFilter__select">
      <select class="js-select" id="kraj" name="kraj">
        <option>Školní liga</option>
        <option>Plzeňský kraj</option>
        <option>Karlovarský kraj</option>
        <option>Ústecký kraj</option>
        <option>Pardubický kraj</option>
      </select>
    </div>
  </form>
  <h2 class="h2 text-center mb-xl-10 mb-md-8 mb-6 subtitle-decore">
    Školní liga Jihomoravského kraje
  </h2>

  <ul
    class="nav gap-2 nav-tabs justify-content-center flex-wrap mb-6"
    id="myTab"
    role="tablist"
  >
    <li class="nav-item" role="presentation">
      <button
        class="nav-link active"
        id="boys-tab"
        data-bs-toggle="tab"
        data-bs-target="#boys"
        type="button"
        role="tab"
        aria-controls="boys"
        aria-selected="true"
      >
        Tým chlapci
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button
        class="nav-link"
        id="girls-tab"
        data-bs-toggle="tab"
        data-bs-target="#girls"
        type="button"
        role="tab"
        aria-controls="girls"
        aria-selected="false"
      >
        Tým dívky
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button
        class="nav-link"
        id="mix-tab"
        data-bs-toggle="tab"
        data-bs-target="#mix"
        type="button"
        role="tab"
        aria-controls="mix"
        aria-selected="false"
      >
        Smíšený tým
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button
        class="nav-link"
        id="games-tab"
        data-bs-toggle="tab"
        data-bs-target="#games"
        type="button"
        role="tab"
        aria-controls="games"
        aria-selected="false"
      >
        Turnaje a zápasy
      </button>
    </li>
  </ul>

  <div class="tab-content" id="registered-tabContent">
    <div
      class="tab-pane show active"
      id="boys"
      role="tabpanel"
      aria-labelledby="boys-tab"
    >
      <div class="text-end mb-6">
        <a href="#" class="button-accent">Nová soupiska</a>
      </div>
      <div class="formular formular-player mb-8">
        <div class="alert alert-success text-center mb-6" role="alert">
          Družstvo spadá do 1.-3. třídy
        </div>
        <h3 class="h3 text-center mb-xl-10 mb-md-8 mb-6 subtitle-decore">
          ZŠ Petra Bezruče - tým chlapci 2
        </h3>
        <h3 class="h5 mb-6">Hráči</h3>
        <div class="d-grid gap-4 mb-8">
          <div class="tournamentItem flex-wrap">
            <ul class="tournamentItem__list">
              <li
                class="fw-semibold justify-content-center justify-content-md-start"
              >
                Moješcik AlexandrAlexandr-Alexandr
              </li>
            </ul>
            <ul class="tournamentItem__list tournamentItem__list-bottom">
              <li class="justify-content-center justify-content-md-start">
                Název třídy
              </li>
              <li class="justify-content-center">17.05.1997</li>
              <li class="justify-content-center">CZ</li>
              <li class="justify-content-center">123456/7890</li>
              <li class="justify-content-md-end justify-content-center">
                <button
                  class="button-accent ms-md-auto mx-md-0 mx-auto text-sm-regular py-2 px-4 rounded-6"
                >
                  Smazat hráče
                </button>
              </li>
            </ul>
          </div>
          <div class="tournamentItem flex-wrap">
            <ul class="tournamentItem__list">
              <li
                class="fw-semibold justify-content-center justify-content-md-start"
              >
                Moješcik AlexandrAlexandr-Alexandr
              </li>
            </ul>
            <ul class="tournamentItem__list tournamentItem__list-bottom">
              <li class="justify-content-center justify-content-md-start">
                Název třídy
              </li>
              <li class="justify-content-center">17.05.1997</li>
              <li class="justify-content-center">DE</li>
              <li class="justify-content-center"></li>
              <li class="justify-content-md-end justify-content-center">
                <button
                  class="button-accent ms-md-auto mx-md-0 mx-auto text-sm-regular py-2 px-4 rounded-6"
                >
                  Smazat hráče
                </button>
              </li>
            </ul>
          </div>
          <div class="tournamentItem flex-wrap">
            <ul class="tournamentItem__list">
              <li
                class="fw-semibold justify-content-center justify-content-md-start"
              >
                Moješcik AlexandrAlexandr-Alexandr
              </li>
            </ul>
            <ul class="tournamentItem__list tournamentItem__list-bottom">
              <li class="justify-content-center justify-content-md-start">
                Název třídy
              </li>
              <li class="justify-content-center"></li>
              <li class="justify-content-center">CZ</li>
              <li class="justify-content-center">123456/7890</li>
              <li class="justify-content-md-end justify-content-center">
                <button
                  class="button-accent ms-md-auto mx-md-0 mx-auto text-sm-regular py-2 px-4 rounded-6"
                >
                  Smazat hráče
                </button>
              </li>
            </ul>
          </div>
          <div class="tournamentItem flex-wrap">
            <ul class="tournamentItem__list">
              <li
                class="fw-semibold justify-content-center justify-content-md-start"
              >
                Moješcik AlexandrAlexandr-Alexandr
              </li>
            </ul>
            <ul class="tournamentItem__list tournamentItem__list-bottom">
              <li class="justify-content-center justify-content-md-start">
                Název třídy
              </li>
              <li class="justify-content-center"></li>
              <li class="justify-content-center">CZ</li>
              <li class="justify-content-center"></li>
              <li class="justify-content-md-end justify-content-center">
                <button
                  class="button-accent ms-md-auto mx-md-0 mx-auto text-sm-regular py-2 px-4 rounded-6"
                >
                  Smazat hráče
                </button>
              </li>
            </ul>
          </div>
        </div>
        <form
          class="d-flex flex-column gap-6"
          action="https://mizza-cz.github.io/skolni-liga-hazena/build/01.0_homepage.html"
          method="post"
        >
          <div class="row g-6">
            <div class="col-12">
              <h3 class="h5">Nový hráč</h3>
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysPlayer-name"
                >Jméno *</label
              >
              <input
                required
                type="text"
                name="boysPlayer-name"
                id="boysPlayer-name"
              />
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysPlayer-surname"
                >příjmení *</label
              >
              <input
                required
                type="text"
                name="boysPlayer-surname"
                id="boysPlayer-surname"
              />
            </div>

            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysPlayer-class"
              >
                Třída *
              </label>
              <div class="formular__select">
                <select
                  required
                  class="js-select"
                  id="boysPlayer-class"
                  name="boysPlayer-class"
                >
                  <option>Vyberte třídu</option>
                  <option>1</option>
                  <option>2</option>
                  <option>3</option>
                  <option>4</option>
                  <option>5</option>
                </select>
              </div>
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysPlayer-date"
                >Datum narození <i class="text-sm-regular">(nepovinný údaj)</i>
              </label>
              <input type="date" name="boysPlayer-date" id="boysPlayer-date" />
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysPlayer-state"
              >
                Národnost
              </label>
              <div class="formular__select">
                <select
                  required
                  class="js-select"
                  id="boysPlayer-state"
                  name="boysPlayer-state"
                >
                  <option>CZ</option>
                  <option>DE</option>
                  <option>SK</option>
                  <option>RU</option>
                  <option>EN</option>
                  <option>KZ</option>
                </select>
              </div>
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysPlayer-numberid"
              >
                Rodné číslo <i class="text-sm-regular">(nepovinný údaj)</i>
              </label>
              <input
                type="text"
                name="boysPlayer-numberid"
                id="boysPlayer-numberid"
                placeholder="123456/7890"
              />
            </div>
            <div class="col-lg-7 col-xl-5">
              <label class="formular__checkbox">
                <input
                  id="boysPlayer-agree"
                  name="boysPlayer-agree"
                  type="checkbox"
                  onchange="toggleClubInput()"
                />
                <span class="custom-checkbox"></span>
                Hráč hraje miniházenou v klubu
                <i class="text-sm-regular">(nepovinný údaj)</i>
              </label>

              <div
                id="clubInputContainer"
                style="display: none; margin-top: 10px"
              >
                <label
                  class="text-sm-regular d-block mb-1 text-primary"
                  for="clubName"
                  >Název klubu
                </label>
                <input
                  type="text"
                  id="clubName"
                  name="clubName"
                  placeholder="Zadejte název klubu"
                />
              </div>
            </div>
          </div>

          <div class="text-center">
            <button class="button-accent">Přidat hráče</button>
          </div>
        </form>
      </div>

      <div class="formular mt-6">
        <h3 class="h5 mb-6">Trenéři</h3>
        <div class="d-grid gap-4 mb-8">
          <div class="tournamentItem flex-wrap">
            <ul class="tournamentItem__list">
              <li
                class="fw-semibold justify-content-center justify-content-md-start"
              >
                Moješcik AlexandrAlexandr-Alexandr
              </li>
            </ul>
            <ul class="tournamentItem__list tournamentItem__list-bottom">
              <li class="justify-content-center justify-content-md-start">
                19.04.1985
              </li>
              <li class="justify-content-center">123456/7890</li>
              <li class="justify-content-center">Trenér</li>
              <li>
                <button
                  class="button-accent ms-md-auto mx-md-0 mx-auto text-sm-regular py-2 px-4 rounded-6"
                >
                  Smazat trenéra
                </button>
              </li>
            </ul>
          </div>
          <div class="tournamentItem flex-wrap">
            <ul class="tournamentItem__list">
              <li
                class="fw-semibold justify-content-center justify-content-md-start"
              >
                Moješcik AlexandrAlexandr-Alexandr
              </li>
            </ul>
            <ul class="tournamentItem__list tournamentItem__list-bottom">
              <li class="justify-content-center justify-content-md-start">
                19.04.1985
              </li>
              <li class="justify-content-center">123456/7890</li>
              <li class="justify-content-center">Trenér</li>
              <li>
                <button
                  class="button-accent ms-md-auto mx-md-0 mx-auto text-sm-regular py-2 px-4 rounded-6"
                >
                  Smazat trenéra
                </button>
              </li>
            </ul>
          </div>
          <div class="tournamentItem flex-wrap">
            <ul class="tournamentItem__list">
              <li
                class="fw-semibold justify-content-center justify-content-md-start"
              >
                Moješcik AlexandrAlexandr-Alexandr
              </li>
            </ul>
            <ul class="tournamentItem__list tournamentItem__list-bottom">
              <li class="justify-content-center justify-content-md-start">
                19.04.1985
              </li>
              <li class="justify-content-center"></li>
              <li class="justify-content-center">Trenér</li>
              <li>
                <button
                  class="button-accent ms-md-auto mx-md-0 mx-auto text-sm-regular py-2 px-4 rounded-6"
                >
                  Smazat trenéra
                </button>
              </li>
            </ul>
          </div>
        </div>
        <form
          class="d-flex flex-column gap-6"
          action="https://mizza-cz.github.io/skolni-liga-hazena/build/01.0_homepage.html"
          method="post"
        >
          <div class="row g-6">
            <div class="col-12">
              <h3 class="h5">Nový trenér</h3>
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysTrainer-name"
