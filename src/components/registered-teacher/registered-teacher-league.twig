                >příjmení *</label
              >
              <input
                required
                type="text"
                name="boysTrainer-surname"
                id="boysTrainer-surname"
              />
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysTrainer-date"
                >Datum narození
              </label>
              <input
                type="date"
                name="boysTrainer-date"
                id="boysTrainer-date"
              />
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysTrainer-numberid"
              >
                Rodné číslo <i class="text-sm-regular">(nepovinný údaj)</i>
              </label>
              <input
                type="text"
                name="boysTrainer-numberid"
                id="boysTrainer-numberid"
                placeholder="123456/7890"
              />
            </div>
            <div class="col-lg-6 col-xl-4">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="boysTrainer-function"
                >Název funkce
              </label>
              <input
                type="text"
                value="Trenér"
                name="boysTrainer-function"
                id="boysTrainer-function"
              />
            </div>
          </div>

          <div class="text-center">
            <button class="button-accent">Přidat trenéra</button>
          </div>
        </form>
      </div>
    </div>
    <div
      class="tab-pane fade"
      id="girls"
      role="tabpanel"
      aria-labelledby="girls-tab"
    >
      <div class="text-end mb-6">
        <a href="#" class="button-accent">Nová soupiska</a>
      </div>
    </div>
    <div
      class="tab-pane fade"
      id="mix"
      role="tabpanel"
      aria-labelledby="mix-tab"
    >
      <div class="text-end mb-6">
        <a href="#" class="button-accent">Nová soupiska</a>
      </div>
    </div>
    <div
      class="tab-pane fade"
      id="games"
      role="tabpanel"
      aria-labelledby="games-tab"
    >
      {% include "@components/registered-teacher/registered-teacher-games.twig"
      %}
    </div>
  </div>
</section>
<script>
  function toggleClubInput() {
    const checkbox = document.getElementById("boysPlayer-agree");
    const inputContainer = document.getElementById("clubInputContainer");
    inputContainer.style.display = checkbox.checked ? "block" : "none";
  }
</script>
