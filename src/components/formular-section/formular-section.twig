<section class="formular-section">
  <div class="header-section">
    <div class="container">
      <div class="header-section__inner">
        <h1 class="h1 text-white title-decore">Přidejte se k nám</h1>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="decore-bottom">
      <h2 class="h2 text-center mb-xl-10 mb-md-8 mb-6">Registrace školy</h2>
      <div class="formular">
        <form
          class="d-grid gap-6"
          action="https://mizza-cz.github.io/skolni-liga-hazena/build/01.0_homepage.html"
          method="post"
        >
          <div class="row g-6">
            <div class="col-12">
              <h3 class="h5">
                Najděte svojí školu a automaticky vyplňte základní údaje
              </h3>
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="school"
              >
                Škola
              </label>
              <div class="formular__select">
                <select class="js-select" id="school" name="club">
                  <option>Vyberte školu z databáze</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                </select>
              </div>
            </div>
            <div class="col-12">
              <h4 class="h5">Základní informace</h4>
            </div>

            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="name-school"
                >Název školy *</label
              >
              <input type="text" name="name-school" id="name-school" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="street"
                >Ulice a č.p. *</label
              >
              <input type="text" name="street" id="street" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="city"
                >Město *</label
              >
              <input type="text" name="city" id="city" />
            </div>
            <div class="col-lg-6">
              <label class="text-sm-regular d-block mb-1 text-primary" for="psc"
                >PSČ *</label
              >
              <input type="text" name="psc" id="psc" />
            </div>
            <div class="col-lg-6">
              <label class="text-sm-regular d-block mb-1 text-primary" for="ico"
                >IČO *</label
              >
              <input type="text" name="ico" id="ico" />
            </div>
            <div class="col-lg-6">
              <label class="text-sm-regular d-block mb-1 text-primary" for="dic"
                >DIČ *</label
              >
              <input type="text" name="dic" id="dic" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="kraj"
              >
                Kraj
              </label>
              <div class="formular__select">
                <select class="js-select" id="kraj" name="kraj">
                  <option>Hlavní město Praha</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                </select>
              </div>
            </div>
            <div class="col-12">
              <h5 class="h5">Školní liga</h5>
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="liga"
              >
                Školní liga
              </label>
              <div class="formular__select">
                <select
                  class="js-select js-select-multiple"
                  id="liga"
                  name="liga[]"
                  multiple
                  required
                >
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                  <option>CZE</option>
                  <option>GBA</option>
                  <option>SVK</option>
                </select>
              </div>
            </div>
            <div class="col-12">
              <h5 class="h5">Kontaktní informace</h5>
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="name"
                >Jméno *</label
              >
              <input type="text" name="name" id="name" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="surname"
                >Příjmení *</label
              >
              <input type="text" name="surname" id="surname" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="email"
                >E-mail *</label
              >
              <input type="email" name="email" id="email" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="phone"
                >Telefon *</label
              >
              <input type="tel" name="phone" id="phone" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="pass-1"
                >Heslo *</label
              >
              <input type="password" name="pass-1" id="pass-1" />
            </div>
            <div class="col-lg-6">
              <label
                class="text-sm-regular d-block mb-1 text-primary"
                for="pass-2"
                >Heslo pro kontrolu *</label
              >
              <input type="password" name="pass-2" id="pass-2" />
            </div>
          </div>
          <label class="formular__checkbox">
            <input name="agree" type="checkbox" />
            <span class="custom-checkbox"></span>
            Odesláním fomuláře souhlasím se
            <a href="#">zpracováním osobních údajů.</a>
          </label>
          <div class="text-center">
            <button class="button-accent">Registrovat</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
