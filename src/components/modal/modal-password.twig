<div
  class="modal fade"
  id="passwordModal"
  aria-labelledby="passwordModalLabel"
  tabindex="-1"
  role="dialog"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <button
        type="button"
        class="close"
        data-bs-dismiss="modal"
        aria-label="Close"
      >
        <img src="images/ico/close.svg" alt="" />
      </button>
      <h4 class="h4 fw-semibold mb-6" id="passwordModalLabel">Změnit heslo</h4>
      <form class="mb-8 formular p-0">
        <label class="text-sm-regular d-block mb-1 text-primary" for="passOld">
          Aktuální heslo
        </label>
        <div class="input-icon mb-3">
          <input id="passOld" name="passOld" type="password" />
        </div>

        <label class="text-sm-regular d-block mb-1 text-primary" for="passNew"
          >Nové heslo</label
        >
        <div class="input-icon mb-3">
          <input id="passNew" name="passNew" type="password" />
        </div>
        <label class="text-sm-regular d-block mb-1 text-primary" for="passNew-2"
          >Potvrzení nového hesla</label
        >
        <div class="input-icon">
          <input id="passNew-2" name="passNew-2" type="password" />
        </div>
        <div
          class="d-flex my-5 justify-content-between gap-3 flex-wrap align-items-center"
        >
          <div class="text-sm-semibold text-gray-500">Zapamatovat heslo?</div>
          <input name="agree" checked type="checkbox" class="inputCheck" />
        </div>
        <button class="button button-accent w-100">Změnit</button>
      </form>
    </div>
  </div>
</div>
