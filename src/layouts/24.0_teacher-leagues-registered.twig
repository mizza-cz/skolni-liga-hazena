{% extends "@components/base/base.twig" %} {% set title =
"24.0_teacher-leagues-registered" %} {% block main %}

<section class="registered-section">
  <div class="header-section">
    <div class="container">
      <div class="header-section__inner">
        <h1 class="h1 text-white title-decore">ZŠ Petra Bezruče</h1>
      </div>
    </div>
  </div>
  <div class="registered-section__content">
    <div class="container">
      <div class="decore-bottom">
        <ul class="menuLinks">
          <li>
            <a
              href="https://mizza-cz.github.io/skolni-liga-hazena/build/19.0_registered-teacher.html"
              >Základní informace
            </a>
          </li>
          <li>
            <a
              class="active"
              href="https://mizza-cz.github.io/skolni-liga-hazena/build/20.0_registered-teacher-league.html"
              >Školní ligy
            </a>
          </li>
          <li>
            <a href="#" data-bs-toggle="modal" data-bs-target="#passwordModal"
              >Změna hesla
            </a>
          </li>
          <li>
            <a href="#"> Odhlásit se </a>
          </li>
        </ul>
        {% include "@components/modal/modal-password.twig" %}

        <section class="registered-teacher">
          <h2 class="h2 text-center mb-xl-10 mb-md-8 mb-6">
            Vaše registrované ligy
          </h2>
          <div class="row g-6">
            {% for i in 1..5 %}
            <div class="col-lg-4 col-sm-6">
              <ul class="leagueItem">
                <li>
                  <div class="h5 mb-2">Školní liga xyz</div>
                  <div class="d-flex gap-1-4 align-items-center flex-wrap">
                    <div class="text-base-semibold text-primary">
                      Název kraje
                    </div>
                    <div class="text-base-normal">Liberec</div>
                  </div>
                </li>
                <li>
                  <div class="leagueItem__tags">
                    <div class="tag-deco-3">Škol: 12</div>
                    <div class="tag-deco-2">1. třída</div>
                    <div class="tag-deco-2">2. třída</div>
                    <div class="tag-deco-2">4. třída</div>
                  </div>
                </li>
                <li>
                  <div class="text-base-normal mb-2">Jméno Příjmení</div>
                  <a
                    href="tel:+420123456789"
                    class="text-base-normal hover-underline d-block"
                  >
                    +420 123 456 789
                  </a>
                </li>
                <li>
                  <a href="#" class="button-accent">Detail ligy </a>
                </li>
              </ul>
            </div>
            {% endfor %}
          </div>
        </section>
      </div>
    </div>
  </div>
</section>
{% include "@components/modal/modal-createPlayers.twig" %} {% include
"@components/modal/modal-editPlayers.twig" %} {% include
"@components/partnersSlider/partnersSlider.twig" %} {% endblock %}
