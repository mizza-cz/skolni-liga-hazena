{% extends "@components/base/base.twig" %} {% set title = "15.0_tournaments" %}
{% block main %}

<section class="registered-schools">
  <div class="header-section">
    <div class="container">
      <div class="header-section__inner">
        <h1 class="h1 text-white title-decore">Školní liga xyz</h1>
      </div>
    </div>
  </div>
  <div class="registered-schools__inner">
    <div class="container">
      <div class="decore-bottom">
        <h5 class="h5 mb-lg-10 mb-6">Liga je pořádaná klubem Slavia Praha.</h5>
        <p class="text-base-normal">
          Lorem ipsum dolor sit amet consectetur. Accumsan id vitae ut bibendum.
          Felis at et commodo lorem phasellus proin. Pharetra diam ultrices
          neque congue. Rutrum ipsum gravida justo adipiscing risus quis
          volutpat. Lorem ipsum dolor sit amet consectetur. Accumsan id vitae ut
          bibendum. Felis at et commodo lorem phasellus proin. Pharetra diam
          ultrices neque congue. Rutrum ipsum gravida justo adipiscing risus
          quis volutpat. Lorem ipsum dolor sit amet consectetur. Accumsan id
          vitae ut bibendum. Felis at et commodo lorem phasellus proin. Pharetra
          diam ultrices neque congue. Rutrum ipsum gravida justo adipiscing
          risus quis volutpat.
        </p>
        <div class="text-base-semibold mb-1 mt-3">Jméno Příjmení</div>
        <div class="d-grid gap-1">
          <div class="text-base-normal">
            email:
            <a class="hover-underline" href="mailto:email@email.com">
              email@email.com
            </a>
          </div>
          <div class="text-base-normal">
            telefon:
            <a class="hover-underline" href="tel:+420123456789"
              >+420 123 456 789</a
            >
          </div>
        </div>
        <ul class="menuLinks mt-lg-16 mt-10">
          <li>
            <a class="active" href="#">Turnaje </a>
          </li>
          <li>
            <a href="#">Registrované školy </a>
          </li>
        </ul>
        <div class="tournBoard">
          <ul class="d-grid gap-4">
            {% for i in 1..4 %}
            <li class="tournItem">
              <a href="#" class="tournItem__link">
                <h3 class="h5">Název Turnaje</h3>
                {% include "@images/chevron-right.svg" %}
              </a>
              <ul class="tournItem__list">
                <li class="w-md-auto w-100 text-base-normal">14. 2. 2024</li>
                <li class="text-base-semibold w-md-auto w-100">Název kraje</li>

                <li class="w-md-auto w-100">
                  <div
                    class="d-flex align-items-center gap-2 text-base-normal flex-wrap"
                  >
                    {% include "@images/pin.svg" %} Sportovní hala ZŠ Petra
                    Bezruče
                  </div>
                </li>
                <li>
                  <div class="tag-deco-1">Dívky</div>
                </li>
                <li>
                  <div class="tag-deco-3">Smíšený</div>
                </li>
                <li>
                  <div class="d-flex align-items-center gap-1">
                    <div class="tag-deco-2">1. třída</div>
                    <div class="tag-deco-2">2. třída</div>
                    <div class="tag-deco-2">3. třída</div>
                  </div>
                </li>
              </ul>
            </li>
            <li class="tournItem">
              <a href="#" class="tournItem__link">
                <h3 class="h5">Mistrovství družstev mládeže</h3>
                {% include "@images/chevron-right.svg" %}
              </a>
              <ul class="tournItem__list">
                <li class="w-md-auto w-100 text-base-normal">14. 2. 2024</li>
                <li class="text-base-semibold w-md-auto w-100">
                  Karlovarský kraj
                </li>
                <li class="w-md-auto w-100">
                  <div
                    class="d-flex align-items-center gap-2 text-base-normal flex-wrap"
                  >
                    {% include "@images/pin.svg" %} K Botyči 128/8, Praha 1,
                    10100
                  </div>
                </li>
                <li>
                  <div class="tag-deco-1">Dívky</div>
                </li>

                <li>
                  <div class="d-flex align-items-center gap-1">
                    <div class="tag-deco-2">1. třída</div>
                    <div class="tag-deco-2">2. třída</div>
                  </div>
                </li>
              </ul>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "@components/partnersSlider/partnersSlider.twig" %} {% endblock %}
