{% extends "@components/base/base.twig" %} {% set title =
"19.0_registered-teacher" %} {% block main %}

<section class="registered-section">
  <div class="header-section">
    <div class="container">
      <div class="header-section__inner">
        <h1 class="h1 text-white title-decore">
          Webové rozhraní pro registrovaného učitele
        </h1>
      </div>
    </div>
  </div>
  <div class="registered-section__content">
    <div class="container">
      <div class="decore-bottom">
        <ul class="menuLinks">
          <li>
            <a href="#">Školní ligy </a>
          </li>
          <li>
            <a href="#">Změna hesla </a>
          </li>
          <li>
            <a href="#">Odhlásit se </a>
          </li>
        </ul>

        <ul class="nav menuLinks" id="myTab" role="tablist">
          <li class="nav-item" role="presentation">
            <button
              class="active"
              id="info-tab"
              data-bs-toggle="tab"
              data-bs-target="#info"
              type="button"
              role="tab"
              aria-controls="info"
              aria-selected="true"
            >
              Základní informace
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class=""
              id="profile-tab"
              data-bs-toggle="tab"
              data-bs-target="#profile"
              type="button"
              role="tab"
              aria-controls="profile"
              aria-selected="false"
            >
              Profile
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button
              class=""
              id="contact-tab"
              data-bs-toggle="tab"
              data-bs-target="#contact"
              type="button"
              role="tab"
              aria-controls="contact"
              aria-selected="false"
            >
              Contact
            </button>
          </li>
        </ul>
        <div class="tab-content" id="myTabContent">
          <div
            class="tab-pane fade show active"
            id="info"
            role="tabpanel"
            aria-labelledby="info-tab"
          >
            12
          </div>
          <div
            class="tab-pane fade"
            id="profile"
            role="tabpanel"
            aria-labelledby="profile-tab"
          >
            22
          </div>
          <div
            class="tab-pane fade"
            id="contact"
            role="tabpanel"
            aria-labelledby="contact-tab"
          >
            33
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "@components/partnersSlider/partnersSlider.twig" %} {% endblock %}
